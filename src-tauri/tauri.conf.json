{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工具箱",
  "version": "0.1.0",
  "identifier": "com.rockeydon.toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "工具箱", "width": 1120, "height": 780, "minWidth": 760, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "随手可用的本地字符工具",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
